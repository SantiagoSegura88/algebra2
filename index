/* ---------- Lab 4: intersección ---------- */
(function(){
  const L=lab('lab-int');
  const F=lineFields(L,'l4',LINES.A);
  L.upd=function(){
    const p=F.P.get(), v=F.v.get(), q=F.Q.get(), w=F.w.get();
    if(V.zero(v)||V.zero(w)){ L.scene.set([]); setOut(L,warn('Ningún vector director puede ser el vector cero.')); return; }
    const r=analyze(p,v,q,w);
    L.scene.set(lineObjs(p,v,q,w,r));
    const a=v, b=w.map(x=>-x), c=V.sub(q,p);
    let h='<p>Igualando $P+t\\,\\vec v=Q+s\\,\\vec w$ componente a componente:</p>';
    h+=R`$$\begin{cases}${[0,1,2].map(i=>lin(p[i],v[i],'t')+' = '+lin(q[i],w[i],'s')).join(R`\\`)}\end{cases}\;\Longrightarrow\;\begin{cases}${[0,1,2].map(i=>combo(a[i],'t',b[i],'s')+' = '+fmt(c[i])+R`&(${i+1})`).join(R`\\`)}\end{cases}$$`;
    const pairs=[[0,1],[0,2],[1,2]]; let f=null;
    for(const [i,j] of pairs){ const det=a[i]*b[j]-a[j]*b[i]; if(!isZ(det)){ f=[i,j,det]; break; } }
    let verd='', cls='';
    const ortTxt=isZ(V.dot(v,w))?R` Además $\vec v\cdot\vec w=0$: son ortogonales.`:'';
    if(f){
      const [i,j,det]=f, k=3-i-j;
      const t=(c[i]*b[j]-c[j]*b[i])/det, s=(a[i]*c[j]-a[j]*c[i])/det;
      const lhs=a[k]*t+b[k]*s, ok=Math.abs(lhs-c[k])<1e-9*(1+Math.abs(c[k]));
      h+=R`<p>Resolviendo (${i+1}) y (${j+1}): $\;t=${fmt(t)},\;\;s=${fmt(s)}$.</p>`;
      const sub=[isZ(a[k])?null:pp(a[k])+pp(t), isZ(b[k])?null:pp(b[k])+pp(s)].filter(Boolean).join(' + ')||'0';
      h+=R`<p>Sustituyendo en (${k+1}): $\;${sub}=${fmt(lhs)}\;${ok?'=':R`\neq`}\;${fmt(c[k])}$ ${ok?'✓ se cumple':'✗ no se cumple'}</p>`;
      if(ok){
        const X=V.add(p,V.mul(t,v));
        verd=R`<b>Se cortan en un punto</b><span>Solución única: el punto es $${vt(X)}$ ($t=${fmt(t)}$ en $\ell_1$, $s=${fmt(s)}$ en $\ell_2$).${ortTxt}</span>`; cls='bien';
      } else {
        verd=R`<b>No se intersecan: son alabeadas</b><span>El sistema es inconsistente y los directores no son paralelos. Distancia $\approx ${dec(r.d,3)}$ (sección 6).${ortTxt}</span>`; cls='mal';
      }
    } else {
      h+=R`<p>Los tres determinantes $2\times2$ del sistema son $0$ porque $\vec v\parallel\vec w$ ($\vec v\times\vec w=\vec 0$). El sistema tiene infinitas soluciones o ninguna. Se revisa si $Q$ está en $\ell_1$:</p>`;
      h+=R`$$\overrightarrow{PQ}=${vt(r.PQ)},\qquad \overrightarrow{PQ}\times\vec v=${vt(V.cross(r.PQ,v))}$$`;
      if(r.caso==='misma'){ verd=R`<b>Son la misma recta</b><span>$Q$ está en $\ell_1$ y las direcciones son paralelas: infinitas soluciones, $\ell_1=\ell_2$.</span>`; cls='bien'; }
      else { verd=R`<b>Paralelas distintas</b><span>$Q$ no está en $\ell_1$: el sistema es inconsistente, $\ell_1\cap\ell_2=\varnothing$. Distancia $\approx ${dec(r.d,3)}$.</span>`; cls='mal'; }
    }
    h+='<div class="veredicto '+cls+'">'+verd+'</div>';
    setOut(L,h);
  };
  presets(L,LINES,d=>{F.P.set(d.P);F.v.set(d.v);F.Q.set(d.Q);F.w.set(d.w);L.upd();});
  L.upd();
})();

