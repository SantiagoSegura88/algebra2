/* ---------- Lab 7: plano ---------- */
function planeEq(n,d){
  let a=n.slice(), dd=d, nota='';
  if([...a,dd].every(x=>Math.abs(x-Math.round(x))<1e-9)){
    a=a.map(Math.round); dd=Math.round(dd);
    let g=a.reduce((g,x)=>gcd(g,x),0); g=gcd(g,dd)||1;
    const lead=a.find(x=>x!==0); const f=(lead<0?-1:1)*g;
    if(f!==1){ a=a.map(x=>x/f); dd=dd/f; nota=R` \quad\text{(dividiendo entre }${f}\text{)}`; }
  }
  const nm=['x','y','z']; let s='';
  for(let i=0;i<3;i++) s+=term(a[i],nm[i],s==='');
  return {tex:(s||'0')+' = '+fmt(dd), nota};
}
(function(){
  const L=lab('lab-plano'), H=L.host();
  const P=vecField(H,'l7P','P','tinta',[1,1,2],upd);
  const v=vecField(H,'l7v',R`\vec v`,'rojo',[2,0,-1],upd);
  const w=vecField(H,'l7w',R`\vec w`,'ambar',[0,2,1],upd);
  const t=slider(H,'l7t','t',-2,2,0.05,1,upd);
  const s=slider(H,'l7s','s',-2,2,0.05,0.75,upd);
  function upd(){
    const p=P.get(), a=v.get(), b=w.get(), tt=t.get(), ss=s.get();
    const n=V.cross(a,b);
    if(V.zero(a)||V.zero(b)||V.zero(n)){
      const dir=V.zero(a)?b:a;
      L.scene.set(V.zero(dir)?[{t:'point',X:p,c:'tinta',label:'P'}]:[{t:'line',P:p,v:dir,c:'rojo',label:'solo una recta'},{t:'arrow',A:p,B:V.add(p,a),c:'rojo',label:'v'},{t:'arrow',A:p,B:V.add(p,b),c:'ambar',label:'w'},{t:'point',X:p,c:'tinta',label:'P'}]);
      setOut(L,warn(R`$\vec v\times\vec w=\vec 0$: los vectores son paralelos (o alguno es $\vec 0$). $P+t\vec v+s\vec w$ solo recorre una recta, no un plano.`));
      return;
    }
    const A1=V.add(p,V.mul(tt,a)), X=V.add(A1,V.mul(ss,b));
    const nn=V.mul(2.2/V.norm(n),n);
    L.scene.set([
      {t:'plane',P:p,v:a,w:b,c:'azul',r:2,a:0.13},
      {t:'arrow',A:p,B:V.add(p,a),c:'rojo',label:'v',w:2.8},{t:'arrow',A:p,B:V.add(p,b),c:'ambar',label:'w',w:2.8},
      {t:'seg',A:p,B:A1,c:'rojo',w:1.6,dash:[5,4]},{t:'seg',A:A1,B:X,c:'ambar',w:1.6,dash:[5,4]},
      {t:'arrow',A:p,B:V.add(p,nn),c:'violeta',label:'n',w:2.2},
      {t:'point',X:p,c:'tinta',label:'P',dx:-14,dy:16},{t:'point',X:X,c:'verde',label:'X'}
    ]);
    const d=V.dot(n,p), eq=planeEq(n,d);
    let h=R`$$X=P+t\,\vec v+s\,\vec w=${vt(p)}+${dec(tt)}\,${vt(a)}+${dec(ss)}\,${vt(b)}=${vtd(X)}$$`;
    h+=R`<p class="nota">Las líneas punteadas son el camino: $t\,\vec v$ (rojo) y luego $s\,\vec w$ (ámbar).</p>`;
    h+=R`<p><span class="chip neu" style="color:var(--ambar)">adelanto</span> Normal: $\vec n=\vec v\times\vec w=${vt(n)}$ (flecha violeta). Con $d=\vec n\cdot P=${fmt(d)}$:</p>`;
    h+=R`$$${eq.tex}${eq.nota}$$`;
    h+=R`<p class="nota">Comprobación: $\vec n\cdot\vec v=${fmt(V.dot(n,a))}$ y $\vec n\cdot\vec w=${fmt(V.dot(n,b))}$.</p>`;
    setOut(L,h);
  }
  presets(L,{base:{P:[1,1,2],v:[2,0,-1],w:[0,2,1]},abc:{P:[1,0,0],v:[-1,2,0],w:[-1,0,3]},malo:{P:[1,1,1],v:[1,2,0],w:[2,4,0]}},d=>{P.set(d.P);v.set(d.v);w.set(d.w);upd();});
  upd();
})();

