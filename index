<style>
:root{
  --papel:#fbfbf8;
  --hoja:#ffffff;
  --tinta:#16233c;
  --tinta-2:#34425c;
  --gris:#5b667d;
  --linea:#d6dde8;
  --cuadro:rgba(47,94,168,.065);
  --azul:#2f5ea8;
  --azul-tenue:#edf2fa;
  --rojo:#b23d2c;
  --rojo-tenue:#fbefec;
  --verde:#1f7a55;
  --verde-tenue:#e8f4ed;
  --ambar:#b0600a;
  --ambar-tenue:#fcf3e3;
  --violeta:#6b4db8;
  --canvas:#ffffff;
  --rejilla:#e6ebf3;
  --eje:#5b667d;
  --serif:"Source Serif 4",Charter,"Bitstream Charter","Sitka Text",Cambria,Georgia,serif;
  --mono:"IBM Plex Mono",ui-monospace,"Cascadia Mono",Consolas,monospace;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    color-scheme:dark;
    --papel:#0f131a;
    --hoja:#151a23;
    --tinta:#e3e8f1;
    --tinta-2:#c4ccdb;
    --gris:#98a3b8;
    --linea:#2a3344;
    --cuadro:rgba(134,170,232,.055);
    --azul:#86aae8;
    --azul-tenue:#18223a;
    --rojo:#ef8d7c;
    --rojo-tenue:#2c1b19;
    --verde:#6acb9b;
    --verde-tenue:#132820;
    --ambar:#e6aa5c;
    --ambar-tenue:#2b2214;
    --violeta:#b69ef2;
    --canvas:#121720;
    --rejilla:#1f2735;
    --eje:#8f9ab0;
  }
}
:root[data-theme="dark"]{
  color-scheme:dark;
  --papel:#0f131a;
  --hoja:#151a23;
  --tinta:#e3e8f1;
  --tinta-2:#c4ccdb;
  --gris:#98a3b8;
  --linea:#2a3344;
  --cuadro:rgba(134,170,232,.055);
  --azul:#86aae8;
  --azul-tenue:#18223a;
  --rojo:#ef8d7c;
  --rojo-tenue:#2c1b19;
  --verde:#6acb9b;
  --verde-tenue:#132820;
  --ambar:#e6aa5c;
  --ambar-tenue:#2b2214;
  --violeta:#b69ef2;
  --canvas:#121720;
  --rejilla:#1f2735;
  --eje:#8f9ab0;
}
*{box-sizing:border-box;}
html{-webkit-text-size-adjust:100%;scroll-padding-top:4rem;}
body{
  background-color:var(--papel);
  background-image:
    linear-gradient(var(--cuadro) 1px, transparent 1px),
    linear-gradient(90deg, var(--cuadro) 1px, transparent 1px);
  background-size:26px 26px;
  color:var(--tinta);
  font-family:var(--serif);
  font-size:17px;
  line-height:1.62;
  padding-inline:16px;
}
.pagina{max-width:54rem;margin:0 auto;padding-block:2.8rem 5rem;}
header.cab{border-bottom:2px solid var(--tinta);padding-bottom:1.3rem;margin-bottom:0;}
.cab .curso{font-family:var(--mono);font-size:.78rem;letter-spacing:.06em;text-transform:uppercase;color:var(--gris);margin:0 0 .6rem 0;}
h1{font-size:2.5rem;line-height:1.08;margin:0 0 .7rem 0;font-weight:700;letter-spacing:-.015em;text-wrap:balance;}
.cab p.bajada{margin:0;max-width:40rem;color:var(--tinta-2);}
.cab .datos{display:flex;flex-wrap:wrap;gap:.5rem 1.4rem;margin-top:1rem;font-size:.9rem;color:var(--gris);}
.cab .datos b{color:var(--tinta);font-weight:600;}

nav.temas{
  position:sticky;top:env(safe-area-inset-top,0px);z-index:10;
  background:var(--papel);
  border-bottom:1px solid var(--linea);
  margin:0 -16px 2.4rem -16px;padding:.55rem 16px;
}
nav.temas ol{list-style:none;margin:0;padding:0;display:flex;gap:.4rem;overflow-x:auto;scrollbar-width:thin;}
nav.temas li{flex:0 0 auto;}
nav.temas a{
  display:block;font-family:var(--mono);font-size:.74rem;white-space:nowrap;
  color:var(--tinta-2);text-decoration:none;padding:.22rem .6rem;border:1px solid var(--linea);border-radius:999px;background:var(--hoja);
}
nav.temas a:hover{border-color:var(--azul);color:var(--azul);}
nav.temas a.activo{background:var(--azul);border-color:var(--azul);color:var(--hoja);}
nav.temas a .n{opacity:.7;margin-right:.3rem;}

section{margin-bottom:4rem;}
h2{font-size:1.6rem;font-weight:700;line-height:1.2;margin:0 0 1rem 0;padding-bottom:.45rem;border-bottom:1px solid var(--linea);text-wrap:balance;}
h2 .num{color:var(--azul);font-weight:400;margin-right:.55rem;font-variant-numeric:tabular-nums;}
h2 .marca{font-family:var(--mono);font-size:.68rem;letter-spacing:.06em;text-transform:uppercase;vertical-align:middle;margin-left:.6rem;padding:.12rem .45rem;border-radius:3px;background:var(--ambar-tenue);color:var(--ambar);border:1px solid currentColor;font-weight:600;}
h3{font-size:1.1rem;font-weight:700;margin:2.1rem 0 .5rem 0;text-wrap:balance;}
p{margin:.75rem 0;}
.prosa{max-width:42rem;}
a{color:var(--azul);}
:focus-visible{outline:2px solid var(--azul);outline-offset:2px;}

.bloque{position:relative;padding:.85rem 1rem .85rem 1.35rem;margin:1.3rem 0;}
.bloque::before{content:"";position:absolute;left:0;top:0;bottom:0;width:11px;border:1.5px solid var(--azul);border-right:none;}
.bloque .rot{display:block;font-weight:700;font-size:.9rem;color:var(--azul);margin-bottom:.15rem;}
.bloque.clave{background:var(--azul-tenue);}
.bloque.aviso{background:var(--rojo-tenue);}
.bloque.aviso::before{border-color:var(--rojo);}
.bloque.aviso .rot{color:var(--rojo);}
.bloque.adelanto{background:var(--ambar-tenue);}
.bloque.adelanto::before{border-color:var(--ambar);}
.bloque.adelanto .rot{color:var(--ambar);}
.bloque > :first-child{margin-top:0;}
.bloque > :last-child{margin-bottom:0;}

ul.props{list-style:none;padding-left:1.15rem;margin:.7rem 0;}
ul.props li{position:relative;margin:.45rem 0;}
ul.props li::before{content:"";position:absolute;left:-1.15rem;top:.62em;width:6px;height:6px;background:var(--azul);}

.ej{border-top:1px solid var(--linea);border-bottom:1px solid var(--linea);padding:1rem 0;margin:1.6rem 0;}
.ej .rot{display:flex;flex-wrap:wrap;align-items:center;gap:.4rem .8rem;font-family:var(--mono);font-size:.76rem;letter-spacing:.04em;text-transform:uppercase;font-weight:600;color:var(--gris);margin-bottom:.45rem;}
.ej .enun{font-style:italic;color:var(--tinta-2);}
ol.pasos{margin:.6rem 0;padding-left:1.4rem;}
ol.pasos li{margin:.5rem 0;padding-left:.2rem;}
ol.pasos li::marker{font-family:var(--mono);font-size:.82rem;color:var(--azul);font-weight:600;}
.nota{font-size:.93rem;color:var(--gris);}
.corr{font-size:.93rem;background:var(--rojo-tenue);border-left:3px solid var(--rojo);padding:.45rem .7rem;margin:.7rem 0;}
.corr b{color:var(--rojo);}

.tabla{overflow-x:auto;margin:1.2rem 0;}
table{width:100%;border-collapse:collapse;font-size:.96rem;}
th,td{text-align:left;padding:.55rem .7rem;border-bottom:1px solid var(--linea);vertical-align:top;}
thead th{border-bottom:1.5px solid var(--tinta);font-family:var(--mono);font-size:.72rem;letter-spacing:.05em;text-transform:uppercase;color:var(--gris);font-weight:600;}
td.ad{color:var(--ambar);font-family:var(--mono);font-size:.72rem;white-space:nowrap;}

.katex{font-size:1.05em;}
.katex-display{overflow-x:auto;overflow-y:hidden;padding:.25rem 0;margin:.7rem 0;}

button{font:inherit;}
.btn{
  font-family:var(--mono);font-size:.76rem;line-height:1.2;
  color:var(--tinta-2);background:var(--hoja);border:1px solid var(--linea);border-radius:4px;
  padding:.38rem .6rem;cursor:pointer;
}
.btn:hover{border-color:var(--azul);color:var(--azul);}
.btn.ir{color:var(--azul);border-color:var(--azul);}
.btn.ir::after{content:" ↓";}

/* ---------- Laboratorios ---------- */
.lab{
  background:var(--hoja);border:1px solid var(--linea);border-radius:6px;
  margin:1.8rem 0;overflow:hidden;
}
.lab-head{display:flex;flex-wrap:wrap;align-items:baseline;gap:.2rem .8rem;padding:.7rem 1rem;border-bottom:1px solid var(--linea);}
.lab-tag{font-family:var(--mono);font-size:.7rem;letter-spacing:.07em;text-transform:uppercase;color:var(--azul);font-weight:600;}
.lab-title{font-weight:700;font-size:1.02rem;}
.lab-hint{margin-left:auto;font-family:var(--mono);font-size:.7rem;color:var(--gris);}
.lab-body{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,1fr);}
.lab-body.solo{grid-template-columns:minmax(0,1fr);}
.lab-view{position:relative;border-right:1px solid var(--linea);background:var(--canvas);min-height:320px;}
.lab-view canvas{display:block;width:100%;height:380px;touch-action:none;cursor:grab;}
.lab-view canvas:active{cursor:grabbing;}
.vista{position:absolute;right:.5rem;bottom:.5rem;display:flex;gap:.3rem;}
.vista .btn{padding:.25rem .5rem;background:var(--hoja);}
.lab-ctrl{padding:.9rem 1rem;display:flex;flex-direction:column;gap:.6rem;}
.lab-ctrl .grupo-lab{font-family:var(--mono);font-size:.68rem;letter-spacing:.06em;text-transform:uppercase;color:var(--gris);margin-top:.2rem;}
.vrow{display:flex;align-items:center;gap:.5rem;}
.vlab{min-width:2.3rem;font-weight:700;}
.vin{display:flex;align-items:center;gap:.1rem;font-family:var(--mono);color:var(--gris);}
.vin input{
  width:3.4rem;font-family:var(--mono);font-size:.9rem;text-align:center;
  color:var(--tinta);background:var(--papel);border:1px solid var(--linea);border-radius:3px;padding:.28rem .2rem;
}
.vin input:focus{border-color:var(--azul);outline:none;box-shadow:0 0 0 2px var(--azul-tenue);}
.vin input.bad{border-color:var(--rojo);background:var(--rojo-tenue);}
.srow{display:flex;align-items:center;gap:.6rem;}
.srow input[type=range]{flex:1;accent-color:var(--verde);min-width:0;}
.srow output{font-family:var(--mono);font-size:.88rem;min-width:3.2rem;text-align:right;color:var(--verde);font-weight:600;}
.presets{display:flex;flex-wrap:wrap;gap:.35rem;margin-top:.3rem;}
.lab-out{border-top:1px solid var(--linea);padding:.4rem 1.1rem 1rem 1.1rem;font-size:.97rem;}
.lab-out p{margin:.55rem 0;}
.veredicto{display:flex;flex-wrap:wrap;align-items:center;gap:.5rem .8rem;margin:.8rem 0 .3rem 0;padding:.6rem .8rem;border-radius:4px;background:var(--azul-tenue);}
.veredicto.bien{background:var(--verde-tenue);}
.veredicto.mal{background:var(--rojo-tenue);}
.veredicto b{font-size:1.02rem;}
.chip{display:inline-block;font-family:var(--mono);font-size:.72rem;font-weight:600;letter-spacing:.03em;padding:.12rem .5rem;border-radius:999px;border:1px solid currentColor;white-space:nowrap;}
.chip.si{color:var(--verde);}
.chip.no{color:var(--rojo);}
.chip.neu{color:var(--gris);}
.chips{display:flex;flex-wrap:wrap;gap:.4rem;margin:.5rem 0;}

details.foto{margin:1.2rem 0;border:1px dashed var(--linea);border-radius:4px;background:var(--hoja);}
details.foto summary{cursor:pointer;padding:.5rem .8rem;font-family:var(--mono);font-size:.76rem;color:var(--gris);}
details.foto summary:hover{color:var(--azul);}
details.foto .fotos{display:flex;flex-wrap:wrap;gap:.8rem;padding:0 .8rem .8rem .8rem;}
details.foto img{width:260px;max-width:100%;height:auto;border-radius:3px;border:1px solid var(--linea);}

/* árbol de decisión */
.arbol{margin:1.6rem 0;font-size:.95rem;}
.nodo{border:1.5px solid var(--tinta);border-radius:4px;padding:.5rem .8rem;background:var(--hoja);text-align:center;}
.nodo.raiz{max-width:22rem;margin:0 auto;}
.ramas{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-top:1.4rem;position:relative;}
.ramas::before{content:"";position:absolute;top:-1.4rem;left:25%;right:25%;height:.7rem;border:1.5px solid var(--gris);border-bottom:none;}
.ramas::after{content:"";position:absolute;top:-2.1rem;left:50%;height:.7rem;border-left:1.5px solid var(--gris);}
.rama{display:flex;flex-direction:column;gap:.6rem;}
.rama .res{font-family:var(--mono);font-size:.74rem;color:var(--gris);text-align:center;}
.hojas{display:grid;grid-template-columns:1fr 1fr;gap:.5rem;}
.fin{border-radius:4px;padding:.55rem .6rem;font-size:.9rem;line-height:1.45;}
.fin b{display:block;font-size:.95rem;}
.fin .res{display:block;text-align:left;margin-bottom:.15rem;}
.fin.toca{background:var(--verde-tenue);border:1px solid var(--verde);}
.fin.nada{background:var(--rojo-tenue);border:1px solid var(--rojo);}

/* práctica */
.preg{border:1px solid var(--linea);border-radius:6px;background:var(--hoja);padding:.9rem 1rem;margin:1rem 0;}
.preg legend{font-family:var(--mono);font-size:.72rem;letter-spacing:.05em;text-transform:uppercase;color:var(--gris);padding:0 .3rem;}
.preg .enun{margin:.1rem 0 .6rem 0;}
.op{display:flex;gap:.6rem;align-items:flex-start;padding:.4rem .5rem;border-radius:4px;cursor:pointer;border:1px solid transparent;}
.op:hover{background:var(--azul-tenue);}
.op input{margin-top:.35rem;accent-color:var(--azul);}
.op.correcta{background:var(--verde-tenue);border-color:var(--verde);}
.op.incorrecta{background:var(--rojo-tenue);border-color:var(--rojo);}
.retro{margin:.6rem 0 0 0;font-size:.93rem;}
