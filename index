    ]);
    let h=R`$$\vec v\cdot\vec w=${dotSteps(a,b)}=${fmt(d)}$$`;
    h+=R`$$\vec v\times\vec w=\big(${pp(a[1])}${pp(b[2])}-${pp(a[2])}${pp(b[1])},\;${pp(a[2])}${pp(b[0])}-${pp(a[0])}${pp(b[2])},\;${pp(a[0])}${pp(b[1])}-${pp(a[1])}${pp(b[0])}\big)=${vt(cx)}$$`;
    const cosT=d/(V.norm(a)*V.norm(b)), th=Math.acos(Math.max(-1,Math.min(1,cosT)))*180/Math.PI, thL=Math.min(th,180-th);
    h+='<div class="chips">'+(par_?'<span class="chip si">Paralelas</span>':'<span class="chip no">No paralelas</span>')+(ort?'<span class="chip si">Ortogonales</span>':'<span class="chip no">No ortogonales</span>')+'</div>';
    if(par_){ const i=[0,1,2].find(k=>!isZ(b[k])); h+=R`<p>$\vec v\times\vec w=\vec 0$, así que $\vec v=${fmt(a[i]/b[i])}\,\vec w$. Las rectas son paralelas; falta ver con un punto si son la misma o distintas (sección 4).</p>`; }
    else if(ort) h+=R`<p>$\vec v\cdot\vec w=0$: las rectas son ortogonales. Pueden cortarse o no; eso lo decide el sistema de la sección 4.</p>`;
    else h+=R`<p>Ni $\vec v\times\vec w=\vec 0$ ni $\vec v\cdot\vec w=0$. Las direcciones forman un ángulo de $${dec(th,1)}^\circ$, así que el ángulo entre las rectas es $${dec(thL,1)}^\circ$.</p>`;
    setOut(L,h);
