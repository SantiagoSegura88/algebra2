  presets(L,{apunte:{v:[1,-2,5],w:[-3,1,1]},par:{v:[2,-1,3],w:[-4,2,-6]},nada:{v:[1,1,0],w:[1,0,1]}},d=>{v.set(d.v);w.set(d.w);upd();});
  upd();
})();

/* ---------- análisis de dos rectas ---------- */
function analyze(p,v,q,w){
  const PQ=V.sub(q,p), cx=V.cross(v,w), r={PQ,cx};
  if(V.zero(cx)){
    r.paral=true; r.k=V.cross(PQ,v);
    if(V.zero(r.k)){ r.caso='misma'; r.d=0; }
    else { r.caso='paralelas'; const tt=V.dot(PQ,v)/V.n2(v); r.A=V.add(p,V.mul(tt,v)); r.B=q; r.d=V.norm(r.k)/V.norm(v); }
  } else {
    r.paral=false; r.trip=V.dot(PQ,cx);
    const a=V.dot(v,v), b=V.dot(v,w), c=V.dot(w,w), d1=V.dot(PQ,v), e1=V.dot(PQ,w), det=b*b-a*c;
    r.t=(-c*d1+b*e1)/det; r.s=(a*e1-b*d1)/det;
    r.A=V.add(p,V.mul(r.t,v)); r.B=V.add(q,V.mul(r.s,w));
    if(Math.abs(r.trip)<1e-9*(1+V.norm(PQ)*V.norm(cx))){ r.caso='cortan'; r.d=0; r.X=r.A; }
    else { r.caso='alabeadas'; r.d=Math.abs(r.trip)/V.norm(cx); }
  }
  return r;
}
function lineObjs(p,v,q,w,r){
  const near=(a,b)=>b&&V.n2(V.sub(a,b))<1e-6;
  const o=[{t:'line',P:p,v:v,c:'azul',label:'ℓ₁'},{t:'line',P:q,v:w,c:'ambar',label:'ℓ₂'},
    {t:'point',X:p,c:'azul',label:near(p,r.X)?'':'P',r:3.8,dx:-14,dy:16},{t:'point',X:q,c:'ambar',label:near(q,r.X)?'':'Q',r:3.8,dx:-14,dy:16}];
  if(r.caso==='cortan') o.push({t:'point',X:r.X,c:'verde',label:'('+r.X.map(x=>dec(x)).join(', ')+')',r:5.5});
  if(r.caso==='alabeadas'||r.caso==='paralelas'){
    o.push({t:'seg',A:r.A,B:r.B,c:'rojo',w:2.4,dash:[6,5],label:'d ≈ '+dec(r.d)});
    o.push({t:'point',X:r.A,c:'rojo',r:3.4},{t:'point',X:r.B,c:'rojo',r:3.4});
  }
  return o;
}
function lineFields(L,pref,d){
