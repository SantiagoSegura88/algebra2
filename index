      } else {
        const c2=V.n2(r.cx), tr=Math.abs(r.trip), ex=exactRatio(tr*tr,c2);
        h+=R`$$d=\frac{|\overrightarrow{PQ}\cdot(\vec v\times\vec w)|}{\|\vec v\times\vec w\|}=\frac{${fmt(tr)}}{\sqrt{${fmt(c2)}}}${ex?'='+ex:''}\approx ${dec(r.d,3)}$$`;
        h+=R`<p class="nota">Los puntos más cercanos son $A\approx${vtd(r.A)}$ en $\ell_1$ ($t\approx${dec(r.t)}$) y $B\approx${vtd(r.B)}$ en $\ell_2$ ($s\approx${dec(r.s)}$). El segmento $AB$ es perpendicular a las dos rectas.</p>`;
        h+=R`<div class="veredicto mal"><b>Alabeadas</b><span>$d(\ell_1,\ell_2)${ex?'='+ex:''}\approx ${dec(r.d,3)}$</span></div>`;
      }
    }
    setOut(L,h);
  };
