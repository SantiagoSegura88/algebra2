function symNum(name,p){ p=clean(p); if(p===0) return name; return p>0? name+' - '+fmt(p) : name+' + '+fmt(-p); }
function symAlt(name,p){ p=clean(p); if(p===0) return '-'+name; return fmt(p)+' - '+name; }
(function(){
  const L=lab('lab-formas'), H=L.host();
  const P=vecField(H,'l2P','P','tinta',[2,0,-1],upd);
  const v=vecField(H,'l2v',R`\vec v`,'rojo',[3,5,2],upd);
  function upd(){
    const p=P.get(), vv=v.get(), nm=['x','y','z'];
    if(V.zero(vv)){ setOut(L,warn(R`Con $\vec v=\vec 0$ no hay recta.`)); return; }
    let h='<p><b>Vectorial</b></p>'+R`$$\begin{pmatrix}x\\y\\z\end{pmatrix}=${col(p)}+t\,${col(vv)},\quad t\in\mathbb{R}$$`;
    h+='<p><b>Paramétricas</b></p>'+R`$$\begin{cases}x=${lin(p[0],vv[0],'t')}\\ y=${lin(p[1],vv[1],'t')}\\ z=${lin(p[2],vv[2],'t')}\end{cases}\qquad t\in\mathbb{R}$$`;
    const nz=[0,1,2].filter(i=>!isZ(vv[i])), zs=[0,1,2].filter(i=>isZ(vv[i]));
    const frac=i=>{ const num=symNum(nm[i],p[i]); return Math.abs(vv[i]-1)<1e-12? num : R`\dfrac{${num}}{${fmt(vv[i])}}`; };
    h+='<p><b>Simétricas</b></p>';
    const consts=zs.map(i=>nm[i]+'='+fmt(p[i])).join(R`,\quad `);
    if(nz.length>=2){
      h+=R`$$${nz.map(frac).join(' = ')}${consts?R`,\qquad `+consts:''}$$`;
      const negs=nz.filter(i=>vv[i]<0);
      if(negs.length){
        const alt=nz.map(i=>{ if(vv[i]<0){ const a=-vv[i]; return Math.abs(a-1)<1e-12? symAlt(nm[i],p[i]) : R`\dfrac{${symAlt(nm[i],p[i])}}{${fmt(a)}}`; } return frac(i); }).join(' = ');
        h+=R`<p class="nota">Con denominadores negativos también se escribe multiplicando arriba y abajo por $-1$: $\;${alt}$. Es la misma recta: así apareció $\frac{5-z}{3}$ en el ejemplo B.</p>`;
      }
      if(zs.length) h+=R`<p class="nota">La componente ${zs.map(i=>'$v_'+(i+1)+'=0$').join(' y ')} no se puede poner como denominador: esa coordenada queda fija y se escribe aparte.</p>`;
    } else {
      const i=nz[0];
      h+=R`$$${consts}$$<p class="nota">Solo $${nm[i]}$ varía (toma cualquier valor), así que no hay cadena de igualdades: la recta es paralela al eje $${nm[i]}$.</p>`;
    }
    setOut(L,h);
  }
  presets(L,{apunte:{P:[2,0,-1],v:[3,5,2]},neg:{P:[1,3,5],v:[7,1,-3]},cero:{P:[4,1,0],v:[-1,0,3]}},d=>{P.set(d.P);v.set(d.v);upd();});
  upd();
})();

