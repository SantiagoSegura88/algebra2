/* ---------- Lab 6: distancia entre rectas ---------- */
(function(){
  const L=lab('lab-drr');
  const F=lineFields(L,'l6',LINES.B);
  L.upd=function(){
    const p=F.P.get(), v=F.v.get(), q=F.Q.get(), w=F.w.get();
    if(V.zero(v)||V.zero(w)){ L.scene.set([]); setOut(L,warn('Ningún vector director puede ser el vector cero.')); return; }
    const r=analyze(p,v,q,w);
    L.scene.set(lineObjs(p,v,q,w,r));
    let h=R`<p>$\overrightarrow{PQ}=Q-P=${vt(r.PQ)}$, $\quad\vec v\times\vec w=${vt(r.cx)}$</p>`;
    if(r.caso==='misma'){
      h+=R`<p>$\vec v\times\vec w=\vec 0$ y $\overrightarrow{PQ}\times\vec v=\vec 0$: es la misma recta.</p><div class="veredicto bien"><b>$d=0$</b><span>Las rectas coinciden.</span></div>`;
    } else if(r.caso==='paralelas'){
      const n2=V.n2(r.k), m2=V.n2(v), ex=exactRatio(n2,m2);
      h+=R`<p>$\vec v\times\vec w=\vec 0$: son paralelas. Se usa la distancia de $Q$ a $\ell_1$:</p>`;
      h+=R`$$\overrightarrow{PQ}\times\vec v=${vt(r.k)},\qquad d=\frac{\|\overrightarrow{PQ}\times\vec v\|}{\|\vec v\|}=\frac{\sqrt{${fmt(n2)}}}{\sqrt{${fmt(m2)}}}${ex?'='+ex:''}\approx ${dec(r.d,3)}$$`;
      h+=R`<div class="veredicto mal"><b>Paralelas distintas</b><span>$d(\ell_1,\ell_2)${ex?'='+ex:''}\approx ${dec(r.d,3)}$</span></div>`;
    } else {
      h+=R`<p>No son paralelas. Se calcula el producto mixto:</p>`;
      h+=R`$$\overrightarrow{PQ}\cdot(\vec v\times\vec w)=${dotSteps(r.PQ,r.cx)}=${fmt(r.trip)}$$`;
      if(r.caso==='cortan'){
