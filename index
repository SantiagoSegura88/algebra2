<script>
(function(){
"use strict";
const R = String.raw;
const KOPTS = {delimiters:[{left:'$$',right:'$$',display:true},{left:'$',right:'$',display:false}],throwOnError:false};
function math(el){ if(window.renderMathInElement){ try{ renderMathInElement(el,KOPTS); }catch(e){} } }

/* ---------- aritmética ---------- */
const isZ = x => Math.abs(x) < 1e-9;
const V = {
  add:(a,b)=>a.map((x,i)=>x+b[i]),
  sub:(a,b)=>a.map((x,i)=>x-b[i]),
  mul:(k,a)=>a.map(x=>k*x),
  dot:(a,b)=>a[0]*b[0]+a[1]*b[1]+a[2]*b[2],
  cross:(a,b)=>[a[1]*b[2]-a[2]*b[1], a[2]*b[0]-a[0]*b[2], a[0]*b[1]-a[1]*b[0]],
  n2:a=>a[0]*a[0]+a[1]*a[1]+a[2]*a[2],
  norm:a=>Math.sqrt(a[0]*a[0]+a[1]*a[1]+a[2]*a[2]),
  zero:a=>a.every(x=>Math.abs(x)<1e-9),
  unit:a=>{const n=Math.sqrt(a[0]*a[0]+a[1]*a[1]+a[2]*a[2]);return a.map(x=>x/n);}
};
function gcd(a,b){a=Math.abs(a);b=Math.abs(b);while(b){const t=a%b;a=b;b=t;}return a;}
function clean(x){ return isZ(x)?0:x; }
function toFrac(x){
  if(!isFinite(x)) return null;
  for(let d=1; d<=1000; d++){
    const n=Math.round(x*d);
    if(Math.abs(n/d-x) < 1e-9*Math.max(1,Math.abs(x))){ const g=gcd(n,d)||1; return [n/g,d/g]; }
  }
  return null;
}
function dec(x,k){ k=k===undefined?2:k; const s=(Math.round(clean(x)*Math.pow(10,k))/Math.pow(10,k)).toFixed(k).replace(/\.?0+$/,''); return s==='-0'?'0':s; }
function fmt(x){
  x=clean(x);
  if(x===0) return '0';
  const f=toFrac(x);
  if(!f || Math.abs(f[0])>99999) return dec(x,3);
  const n=f[0], d=f[1];
  if(d===1) return String(n);
  return (n<0?'-':'')+R`\frac{${Math.abs(n)}}{${d}}`;
}
const par = x => (clean(x)<0 ? '('+fmt(x)+')' : fmt(x));
const pp = x => '('+fmt(x)+')';
const vt = v => R`\left(${v.map(fmt).join(R`,\,`)}\right)`;
const vtd = v => R`\left(${v.map(x=>dec(x)).join(R`,\;`)}\right)`;
const col = v => R`\begin{pmatrix}${v.map(fmt).join(R`\\`)}\end{pmatrix}`;
function term(c,name,first){
  c=clean(c); if(c===0) return '';
  const neg=c<0, a=Math.abs(c), cs=(Math.abs(a-1)<1e-12)?'':fmt(a);
  if(first) return (neg?'-':'')+cs+name;
  return (neg?' - ':' + ')+cs+name;
}
function lin(p,v,name){ let s=isZ(p)?'':fmt(p); s+=term(v,name,s===''); return s||'0'; }
function combo(a,x,b,y){ let s=term(a,x,true); s+=term(b,y,s===''); return s||'0'; }
const dotSteps = (a,b) => [0,1,2].map(i=>pp(a[i])+pp(b[i])).join(' + ');
function simpSqrt(n){ let k=1,m=n; for(let f=2; f*f<=m; f++){ while(m%(f*f)===0){ m/=f*f; k*=f; } } return [k,m]; }
function sqrtRatio(A,B){ // √(A/B), A,B enteros ≥0
  if(A===0) return '0';
  const g=gcd(A,B); A/=g; B/=g;
  if(A*B>9e14) return null;
  let [k,m]=simpSqrt(A*B); let den=B; const g2=gcd(k,den); k/=g2; den/=g2;
  const num = m===1 ? String(k) : (k===1?'':k)+R`\sqrt{${m}}`;
  return den===1 ? num : R`\frac{${num}}{${den}}`;
}
function exactSqrt(q){ // √q con q ≥ 0 racional → latex exacto o null
  if(isZ(q)) return '0';
  const f=toFrac(q); if(!f) return null;
  return sqrtRatio(f[0],f[1]);
}
function exactRatio(num2,den2){ // √(num2)/√(den2)
  const a=toFrac(num2), b=toFrac(den2); if(!a||!b) return null;
  return sqrtRatio(a[0]*b[1], a[1]*b[0]);
}
function parseNum(s){
  s=String(s).trim().replace(/[−–]/g,'-').replace(',','.');
  if(s==='') return null;
  const m=s.match(/^(-?\d*\.?\d+)\s*\/\s*(-?\d*\.?\d+)$/);
  if(m){ const d=Number(m[2]); if(d===0) return null; return Number(m[1])/d; }
  if(!/^-?\d*\.?\d+$/.test(s)) return null;
  return Number(s);
}

/* ---------- paleta desde los tokens ---------- */
const PAL={};
function readPal(){
  const cs=getComputedStyle(document.documentElement);
  ['tinta','gris','linea','azul','rojo','verde','ambar','violeta','canvas','rejilla','eje','hoja'].forEach(k=>{PAL[k]=cs.getPropertyValue('--'+k).trim()||'#888';});
}
readPal();
function alpha(hex,a){
  const h=hex.replace('#','');
  if(h.length!==6) return hex;
  const r=parseInt(h.slice(0,2),16),g=parseInt(h.slice(2,4),16),b=parseInt(h.slice(4,6),16);
  return `rgba(${r},${g},${b},${a})`;
}

/* ---------- escena 3D (proyección ortográfica) ---------- */
const scenes=[];
class Scene3D{
  constructor(canvas){
    this.cv=canvas; this.ctx=canvas.getContext('2d');
    this.objs=[]; this.L=6; this.zoom=1;
    this.home={yaw:-2.2,pitch:0.42};
    this.yaw=this.home.yaw; this.pitch=this.home.pitch;
    this.ptrs=new Map();
    canvas.tabIndex=0;
    canvas.addEventListener('pointerdown',e=>{ try{canvas.setPointerCapture(e.pointerId);}catch(_){} this.ptrs.set(e.pointerId,{x:e.clientX,y:e.clientY}); });
    canvas.addEventListener('pointermove',e=>{
      const prev=this.ptrs.get(e.pointerId); if(!prev) return;
      const cur={x:e.clientX,y:e.clientY};
      if(this.ptrs.size===1){
        this.yaw+=(cur.x-prev.x)*0.011;
        this.pitch=Math.max(-0.35,Math.min(1.52,this.pitch+(cur.y-prev.y)*0.011));
      } else {
        const other=[...this.ptrs.entries()].find(([id])=>id!==e.pointerId);
        if(other){ const o=other[1]; const d0=Math.hypot(prev.x-o.x,prev.y-o.y), d1=Math.hypot(cur.x-o.x,cur.y-o.y); if(d0>4) this.setZoom(this.zoom*d1/d0); }
      }
      this.ptrs.set(e.pointerId,cur); this.draw();
    });
    const up=e=>this.ptrs.delete(e.pointerId);
    canvas.addEventListener('pointerup',up); canvas.addEventListener('pointercancel',up); canvas.addEventListener('lostpointercapture',up);
    canvas.addEventListener('dblclick',()=>this.resetView());
    canvas.addEventListener('keydown',e=>{
      const k=e.key; let used=true;
      if(k==='ArrowLeft') this.yaw-=0.12; else if(k==='ArrowRight') this.yaw+=0.12;
      else if(k==='ArrowUp') this.pitch=Math.min(1.52,this.pitch+0.12); else if(k==='ArrowDown') this.pitch=Math.max(-0.35,this.pitch-0.12);
      else if(k==='+'||k==='=') this.setZoom(this.zoom*1.2); else if(k==='-') this.setZoom(this.zoom/1.2);
      else used=false;
      if(used){ e.preventDefault(); this.draw(); }
    });
    // botones de vista
    const tools=document.createElement('div'); tools.className='vista';
    tools.innerHTML='<button class="btn" type="button" aria-label="Acercar">+</button><button class="btn" type="button" aria-label="Alejar">−</button><button class="btn" type="button">Vista inicial</button>';
    const bs=tools.querySelectorAll('button');
    bs[0].addEventListener('click',()=>{this.setZoom(this.zoom*1.25);this.draw();});
    bs[1].addEventListener('click',()=>{this.setZoom(this.zoom/1.25);this.draw();});
    bs[2].addEventListener('click',()=>this.resetView());
    canvas.parentNode.appendChild(tools);
    if('ResizeObserver' in window){ new ResizeObserver(()=>this.resize()).observe(canvas); }
    window.addEventListener('resize',()=>this.resize());
    scenes.push(this);
    this.resize();
  }
  setZoom(z){ this.zoom=Math.max(0.35,Math.min(5,z)); }
  setHome(yaw,pitch){ this.home={yaw,pitch}; this.yaw=yaw; this.pitch=pitch; }
  resetView(){ this.yaw=this.home.yaw; this.pitch=this.home.pitch; this.zoom=1; this.draw(); }
  resize(){
    const r=this.cv.getBoundingClientRect(); if(!r.width) return;
    const dpr=window.devicePixelRatio||1;
    this.cv.width=Math.round(r.width*dpr); this.cv.height=Math.round(r.height*dpr);
    this.ctx.setTransform(dpr,0,0,dpr,0,0); this.w=r.width; this.h=r.height; this.draw();
  }
  set(objs,L){ this.objs=objs; this.L=L||autoL(objs); this.draw(); }
  P(p){
    const cy=Math.cos(this.yaw), sy=Math.sin(this.yaw), cp=Math.cos(this.pitch), sp=Math.sin(this.pitch);
    const x1=p[0]*cy-p[1]*sy, y1=p[0]*sy+p[1]*cy, z=p[2];
    const upv=z*cp+y1*sp, depth=y1*cp-z*sp;
    const s=Math.min(this.w/2.5,this.h/2.25)/this.L*this.zoom;
    return {x:this.w/2+x1*s, y:this.h/2-upv*s+this.h*0.03, d:depth};
  }
  seg(a,b,color,w,dash){
    const c=this.ctx, A=this.P(a), B=this.P(b);
    c.beginPath(); c.moveTo(A.x,A.y); c.lineTo(B.x,B.y);
    c.strokeStyle=color; c.lineWidth=w||1.5; c.setLineDash(dash||[]); c.stroke(); c.setLineDash([]);
  }
  arrow(a,b,color,w){
    const c=this.ctx, A=this.P(a), B=this.P(b);
    const len=Math.hypot(B.x-A.x,B.y-A.y); if(len<1) return;
    const ang=Math.atan2(B.y-A.y,B.x-A.x), hl=Math.min(11,len*0.45);
    c.beginPath(); c.moveTo(A.x,A.y); c.lineTo(B.x-Math.cos(ang)*hl*0.7,B.y-Math.sin(ang)*hl*0.7);
    c.strokeStyle=color; c.lineWidth=w||2.4; c.setLineDash([]); c.stroke();
    c.beginPath(); c.moveTo(B.x,B.y);
    c.lineTo(B.x-hl*Math.cos(ang-0.38),B.y-hl*Math.sin(ang-0.38));
    c.lineTo(B.x-hl*Math.cos(ang+0.38),B.y-hl*Math.sin(ang+0.38));
    c.closePath(); c.fillStyle=color; c.fill();
  }
  label(p,text,color,dx,dy){
    if(!text) return;
    const c=this.ctx, A=this.P(p);
    c.font='600 12.5px "IBM Plex Mono", ui-monospace, monospace';
    c.lineJoin='round'; c.lineWidth=4; c.strokeStyle=PAL.canvas;
    const x=A.x+(dx===undefined?7:dx), y=A.y+(dy===undefined?-8:dy);
    c.strokeText(text,x,y); c.fillStyle=color; c.fillText(text,x,y);
  }
  clip(P,v,B){
    let t0=-Infinity,t1=Infinity;
    for(let i=0;i<3;i++){
      if(Math.abs(v[i])<1e-12){ if(Math.abs(P[i])>B) return null; continue; }
      let a=(-B-P[i])/v[i], b=(B-P[i])/v[i]; if(a>b){const t=a;a=b;b=t;}
      t0=Math.max(t0,a); t1=Math.min(t1,b);
    }
    return t0<t1?[t0,t1]:null;
  }
  col(name){ return PAL[name]||name; }
  draw(){
    if(!this.w) return;
    const c=this.ctx, L=this.L, st=L<=6?1:L<=12?2:L<=25?5:10;
    c.clearRect(0,0,this.w,this.h); c.fillStyle=PAL.canvas; c.fillRect(0,0,this.w,this.h);
    // rejilla z=0
    for(let k=-Math.floor(L/st)*st;k<=L;k+=st){
      this.seg([k,-L,0],[k,L,0],PAL.rejilla,1); this.seg([-L,k,0],[L,k,0],PAL.rejilla,1);
    }
    // ejes
    const names=['x','y','z'];
    for(let i=0;i<3;i++){
      const e=[0,0,0]; e[i]=1;
      this.seg([0,0,0],V.mul(-L,e),PAL.eje,1.1,[3,4]);
      this.arrow([0,0,0],V.mul(L*1.1,e),PAL.eje,1.3);
      this.label(V.mul(L*1.18,e),names[i],PAL.eje,-4,4);
      c.font='10.5px "IBM Plex Mono", ui-monospace, monospace'; c.fillStyle=PAL.gris;
      for(let k=st;k<L;k+=st){
        const q=this.P(V.mul(k,e)); c.beginPath(); c.arc(q.x,q.y,1.6,0,7); c.fill();
        if(k%(st*2)===0||L<=4) c.fillText(String(k),q.x+4,q.y+12);
      }
    }
    const planes=this.objs.filter(o=>o.t==='plane'||o.t==='planeN');
    const polys=planes.map(o=>{
      let corners,grid=[];
      if(o.t==='plane'){
        const r=o.r||2, pts=[[-r,-r],[r,-r],[r,r],[-r,r]];
        corners=pts.map(([a,b])=>V.add(o.P,V.add(V.mul(a,o.v),V.mul(b,o.w))));
        for(let k=-r;k<=r;k++){
          grid.push([V.add(o.P,V.add(V.mul(k,o.v),V.mul(-r,o.w))),V.add(o.P,V.add(V.mul(k,o.v),V.mul(r,o.w)))]);
          grid.push([V.add(o.P,V.add(V.mul(-r,o.v),V.mul(k,o.w))),V.add(o.P,V.add(V.mul(r,o.v),V.mul(k,o.w)))]);
        }
      } else {
        const n=o.n, C=V.mul(o.d/V.n2(n),n);
        const a=Math.abs(n[0])<0.6*V.norm(n)?[1,0,0]:[0,1,0];
        const e1=V.unit(V.cross(n,a)), e2=V.unit(V.cross(n,e1)), h=o.size||L*0.85;
        corners=[[-1,-1],[1,-1],[1,1],[-1,1]].map(([a1,b1])=>V.add(C,V.add(V.mul(a1*h,e1),V.mul(b1*h,e2))));
        for(let k=-2;k<=2;k++){
          const f=k/2*h;
          grid.push([V.add(C,V.add(V.mul(f,e1),V.mul(-h,e2))),V.add(C,V.add(V.mul(f,e1),V.mul(h,e2)))]);
          grid.push([V.add(C,V.add(V.mul(-h,e1),V.mul(f,e2))),V.add(C,V.add(V.mul(h,e1),V.mul(f,e2)))]);
        }
      }
      const depth=corners.reduce((s,p)=>s+this.P(p).d,0)/4;
      return {o,corners,grid,depth};
    }).sort((a,b)=>b.depth-a.depth);
    for(const p of polys){
      const col=this.col(p.o.c);
      c.beginPath(); p.corners.forEach((q,i)=>{const s=this.P(q); if(i) c.lineTo(s.x,s.y); else c.moveTo(s.x,s.y);}); c.closePath();
      c.fillStyle=alpha(col,p.o.a||0.16); c.fill(); c.strokeStyle=alpha(col,0.55); c.lineWidth=1.2; c.stroke();
      for(const g of p.grid) this.seg(g[0],g[1],alpha(col,0.25),1);
      if(p.o.label) this.label(p.corners[2],p.o.label,col,-18,14);
    }
    for(const o of this.objs){
      const col=this.col(o.c);
      if(o.t==='line'){
        const tr=this.clip(o.P,o.v,L*1.05); if(!tr) continue;
        const a=V.add(o.P,V.mul(tr[0],o.v)), b=V.add(o.P,V.mul(tr[1],o.v));
        this.seg(a,b,o.faint?alpha(col,0.45):col,o.w||2.3,o.dash);
        if(o.label) this.label(V.add(o.P,V.mul(tr[0]+0.9*(tr[1]-tr[0]),o.v)),o.label,col,8,-8);
      } else if(o.t==='seg'){
        this.seg(o.A,o.B,col,o.w||2,o.dash);
        if(o.label) this.label(V.mul(0.5,V.add(o.A,o.B)),o.label,col,8,4);
      } else if(o.t==='arrow'){
        this.arrow(o.A,o.B,col,o.w);
        if(o.label) this.label(o.B,o.label,col,6,-6);
      }
    }
    for(const o of this.objs){
      if(o.t!=='point') continue;
      const col=this.col(o.c), q=this.P(o.X);
      c.beginPath(); c.arc(q.x,q.y,o.r||4.6,0,7); c.fillStyle=col; c.fill(); c.lineWidth=2; c.strokeStyle=PAL.canvas; c.stroke();
      if(o.label) this.label(o.X,o.label,col,o.dx,o.dy);
    }
  }
}
function autoL(objs){
  let m=3;
  const see=p=>{ if(p) for(const x of p) if(isFinite(x)) m=Math.max(m,Math.abs(x)); };
  for(const o of objs){
    if(o.t==='line'){ see(o.P); }
    else if(o.t==='point'){ see(o.X); }
    else if(o.t==='arrow'||o.t==='seg'){ see(o.A); see(o.B); }
    else if(o.t==='plane'){ const r=(o.r||2)*0.8; [[-1,-1],[1,-1],[1,1],[-1,1]].forEach(([a,b])=>see(V.add(o.P,V.add(V.mul(a*r,o.v),V.mul(b*r,o.w))))); }
    else if(o.t==='planeN'){ const C=V.mul(o.d/V.n2(o.n),o.n); see(C); m=Math.max(m,(o.size||0)*0.8); }
  }
  return Math.min(40,Math.max(4,Math.ceil(m*1.05)));
}
function redrawAll(){ readPal(); scenes.forEach(s=>s.draw()); }

/* ---------- controles ---------- */
function vecField(host,id,tex,color,init,onChange){
  const row=document.createElement('div'); row.className='vrow';
  const comp='xyz';
  row.innerHTML='<label class="vlab" style="color:var(--'+color+')" for="'+id+'-0">$'+tex+'$</label><div class="vin"><span>(</span>'+
    [0,1,2].map(i=>'<input id="'+id+'-'+i+'" type="text" inputmode="text" autocomplete="off" spellcheck="false" value="'+init[i]+'" aria-label="'+tex.replace(/\\vec |\\/g,'')+', componente '+comp[i]+'">').join('<span>,</span>')+
    '<span>)</span></div>';
  host.appendChild(row);
  const ins=[0,1,2].map(i=>row.querySelector('#'+id+'-'+i));
  let last=init.slice();
  ins.forEach(inp=>inp.addEventListener('input',onChange));
  return {
    get(){ return ins.map((inp,i)=>{ const x=parseNum(inp.value); inp.classList.toggle('bad',x===null); inp.setAttribute('aria-invalid',x===null?'true':'false'); if(x===null) return last[i]; last[i]=x; return x; }); },
    set(v){ ins.forEach((inp,i)=>{ inp.value=String(v[i]); inp.classList.remove('bad'); }); last=v.slice(); }
  };
}
function slider(host,id,tex,min,max,step,init,onChange){
  const row=document.createElement('div'); row.className='srow';
